{
  "name": "intent-solver",
  "version": "0.1.0",
  "description": "Minimal TypeScript intent solver/filler bot for local development and testing",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "local": "./scripts/start-local.sh",
    "demo": "ts-node scripts/demo.ts",
    "test": "jest --runInBand",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts' 'contracts/**/*.sol'"
  },
  "keywords": [
    "blockchain",
    "intent-solver",
    "filler-bot",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@flashbots/ethers-provider-bundle": "^1.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@uniswap/permit2-sdk": "^1.4.0",
    "@uniswap/uniswapx-sdk": "^2.0.1-alpha.10",
    "better-sqlite3": "^9.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "ethers": "^6.11.0",
    "ts-prune": "^0.10.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.1",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.1",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^1.1.1",
    "@typechain/ethers-v6": "^0.4.3",
    "@typechain/hardhat": "^8.0.3",
    "@types/better-sqlite3": "^7.6.8",
    "@types/chai": "^4.3.20",
    "@types/jest": "^29.5.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "chai": "^4.5.0",
    "eslint": "^8.56.0",
    "hardhat": "^2.19.4",
    "hardhat-gas-reporter": "^1.0.10",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "solidity-coverage": "^0.8.16",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  }
}
