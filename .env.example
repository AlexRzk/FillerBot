# Intent Solver Environment Configuration
# SAFETY WARNING: ENABLE_LIVE is false by default. Real network submission requires:
# 1. ENABLE_LIVE=true (must be explicitly set)
# 2. Valid PRIVATE_KEY and RPC_URL for the target network
# 3. Code review of all network submission paths

# Mode: 'local' or 'live'
# - local: Use local test node (Anvil/Hardhat), no real broadcasts
# - live: Requires ENABLE_LIVE=true and valid RPC credentials
MODE=local

# Local test node RPC endpoint (when MODE=local, defaults to http://127.0.0.1:8545)
RPC_URL=http://127.0.0.1:8545

# Fork URL for Anvil (optional, e.g., for testing against mainnet state)
FORK_URL=https://mainnet.optimism.io

# Private key for signing transactions (for testing only, use test/dev account in local mode)
# Default is a test key; DO NOT USE THIS IN PRODUCTION
PRIVATE_KEY=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Chain ID (1=Mainnet, 10=Optimism, 8453=Base, etc.)
CHAIN_ID=31337

# Database file path (relative to project root)
DATABASE_PATH=./data/bot.db

# Enable live network submission (MUST be true to submit real transactions)
# Default: false (safe)
ENABLE_LIVE=false

# Path to mock intents JSON file (used by mockFeed listener in local mode)
MOCK_FEED_FILE=./seeds/mock_intents.json

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Monitor loop interval in milliseconds
MONITOR_INTERVAL_MS=2000

# Minimum expected profit (in quote token wei) to submit a plan
MIN_PROFIT_THRESHOLD=1000000000000000
